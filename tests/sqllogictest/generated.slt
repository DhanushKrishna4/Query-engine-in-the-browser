# GENERATED FILE -- do not edit by hand.
# python3 tools/fuzz_queries.py --seed 51 --count 600
#
# Randomized differential corpus. Expected results come from SQLite;
# a failure here is a real semantic disagreement.
#
# The tables are indexed, so every query that filters on an indexed
# column may be planned as an index scan -- a completely different
# set of rows read, in a different way, and still checked against
# SQLite's answer. The evaluator-agreement test runs the same corpus
# with index scans disabled, so both paths are compared to each
# other as well as to the oracle.

load people data/people.csv
load orders data/orders.csv

index people id
index people city
index people score
index orders person_id
index orders unit_price

query I nosort
SELECT (a.department <= 'Research') FROM people a WHERE (a.active NOT IN (TRUE, FALSE)) ORDER BY 1 DESC
