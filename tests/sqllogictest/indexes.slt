# B+ tree index scans and bloom-filtered scans.
#
# An index changes which rows are *read*, never which rows are *returned*, so
# every query here is checked against SQLite exactly like every other file in
# the corpus. That is the whole point: the oracle does not know the index
# exists, and the answers must not either.
#
# The `index` directive is engine-only -- there is no DDL -- and
# `tools/gen_expected.py` passes it through untouched.

load people data/people.csv
load orders data/orders.csv

index people id
index people city
index people score
index orders person_id

# --- equality, the shape an index serves best -------------------------------

query IT
SELECT id, name FROM people WHERE id = 5
----
5
Barbara Liskov

query IT
SELECT id, name FROM people WHERE city = 'London'
----
1
Ada Lovelace
3
Alan Turing
9
Tim Berners-Lee

# No such row. The tree finds nothing; so must the filter above it.
query IT
SELECT id, name FROM people WHERE id = 999
----

query IT
SELECT id, name FROM people WHERE city = 'Atlantis'
----

# --- ranges -----------------------------------------------------------------

query IT
SELECT id, name FROM people WHERE id > 7
----
8
Margaret Hamilton
9
Tim Berners-Lee
10
Frances Allen

query IT
SELECT id, name FROM people WHERE id >= 3 AND id <= 5
----
3
Alan Turing
4
Edsger Dijkstra
5
Barbara Liskov

query IT
SELECT id, name FROM people WHERE id BETWEEN 4 AND 6
----
4
Edsger Dijkstra
5
Barbara Liskov
6
Donald Knuth

# Two conjuncts narrowing the same bound: the tighter one must win.
query IT
SELECT id, name FROM people WHERE id > 2 AND id > 6
----
7
Katherine Johnson
8
Margaret Hamilton
9
Tim Berners-Lee
10
Frances Allen

query IT
SELECT id, name FROM people WHERE id < 9 AND id <= 4
----
1
Ada Lovelace
2
Grace Hopper
3
Alan Turing
4
Edsger Dijkstra

# An empty interval.
query IT
SELECT id, name FROM people WHERE id > 8 AND id < 3
----

# The literal on the left, so the comparison has to be mirrored.
query IT
SELECT id, name FROM people WHERE 6 < id
----
7
Katherine Johnson
8
Margaret Hamilton
9
Tim Berners-Lee
10
Frances Allen

query T
SELECT name FROM people WHERE 'London' = city
----
Ada Lovelace
Alan Turing
Tim Berners-Lee

# --- NULLs: the boundary the tree is not allowed to cross --------------------
#
# `score` is indexed and has NULLs, which are deliberately absent from the tree.
# Serving IS NULL from the index would return nothing at all, so the planner
# must refuse it -- these two records are what proves it does.

query I
SELECT id FROM people WHERE score IS NULL
----
3
9

query I
SELECT id FROM people WHERE score IS NOT NULL
----
1
2
4
5
6
7
8
10

# `= NULL` is UNKNOWN for every row, index or no index.
query I
SELECT id FROM people WHERE score = NULL
----

# A range on the nullable indexed column: NULLs must stay out of the answer,
# which they do for the ordinary three-valued reason, not because of the index.
query IR
SELECT id, score FROM people WHERE score > 9.0
----
1
9.500
5
9.500
6
9.900
8
9.100

