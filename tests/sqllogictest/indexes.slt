# --- an index that is present but irrelevant to the predicate ---------------

query TI
SELECT name, age FROM people WHERE department = 'Research'
----
Alan Turing
41
Edsger Dijkstra
52
Donald Knuth
61
Tim Berners-Lee
49

# One indexed column constrains, another does not.
query TI
SELECT name, age FROM people WHERE id >= 3 AND department = 'Research'
----
Alan Turing
41
Edsger Dijkstra
52
Donald Knuth
61
Tim Berners-Lee
49

# --- row order is preserved --------------------------------------------------
#
# `nosort` compares row for row. An index scan gathers rows the tree named, so
# without an explicit sort by row id it would emit them in key order -- which
# for the text index is a completely different order from the table's. These
# records fail loudly if that ever regresses.

query IT nosort
SELECT id, name FROM people WHERE id >= 2 AND id <= 9
----
2
Grace Hopper
3
Alan Turing
4
Edsger Dijkstra
5
Barbara Liskov
6
Donald Knuth
7
Katherine Johnson
8
Margaret Hamilton
9
Tim Berners-Lee

query IT nosort
SELECT id, city FROM people WHERE city >= 'Cambridge' AND city <= 'Palo Alto'
----
1
London
2
New York
3
London
5
New York
6
Palo Alto
7
Hampton
8
Cambridge
9
London

query IT nosort
SELECT id, name FROM people WHERE city = 'London'
----
1
Ada Lovelace
3
Alan Turing
9
Tim Berners-Lee

# --- indexes under the rest of the engine -----------------------------------

query TT rowsort
SELECT p.name, o.product FROM people p JOIN orders o ON p.id = o.person_id WHERE p.id = 1
----
Ada Lovelace
keyboard
Ada Lovelace
laptop
Ada Lovelace
mouse

query TI
SELECT city, COUNT(*) FROM people WHERE id <= 6 GROUP BY city ORDER BY city
----
Austin
1
London
2
New York
2
Palo Alto
1

query IT
SELECT id, name FROM people WHERE id >= 4 ORDER BY name LIMIT 3
----
5
Barbara Liskov
6
Donald Knuth
4
Edsger Dijkstra

query I
SELECT COUNT(*) FROM people WHERE id > 3
----
7

query I
SELECT COUNT(*) FROM orders WHERE person_id = 1
----
3

query IT
SELECT id, name FROM people WHERE id IN (SELECT person_id FROM orders WHERE quantity > 2)
----
1
Ada Lovelace
2
Grace Hopper
8
Margaret Hamilton

# A derived table whose scan is indexed.
query IT
SELECT id, name FROM (SELECT * FROM people WHERE id > 5) t WHERE t.age < 50
----
7
Katherine Johnson
8
Margaret Hamilton
9
Tim Berners-Lee
