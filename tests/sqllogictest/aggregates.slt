# GROUP BY, HAVING and the aggregate functions.

load people data/people.csv
load orders data/orders.csv

# Global aggregates over the whole table.
query I nosort
SELECT COUNT(*) FROM people
----
10

# COUNT(col) counts non-NULL values; two scores are NULL.
query II nosort
SELECT COUNT(*), COUNT(score) FROM people
----
10
8

query IIRII nosort
SELECT COUNT(*), SUM(age), AVG(age), MIN(age), MAX(age) FROM people
----
10
462
46.200
36
61

query RRR nosort
SELECT SUM(score), AVG(score), MIN(score) FROM people
----
70.450
8.806
7.000

query TT nosort
SELECT MIN(name), MAX(name) FROM people
----
Ada Lovelace
Tim Berners-Lee

query TT nosort
SELECT MIN(hired), MAX(hired) FROM people
----
1993-04-02
2010-07-04

# The empty-input trap: COUNT is 0 while every other aggregate is NULL, and the
# query still produces exactly one row.
query IIRII nosort
SELECT COUNT(*), SUM(age), AVG(age), MIN(age), MAX(age) FROM people WHERE 1 = 0
----
0
NULL
NULL
NULL
NULL

# With a GROUP BY, no rows means no groups -- so genuinely zero rows out.
query TI rowsort
SELECT city, COUNT(*) FROM people WHERE 1 = 0 GROUP BY city
----

# COUNT DISTINCT.
query III nosort
SELECT COUNT(city), COUNT(DISTINCT city), COUNT(DISTINCT department) FROM people
----
10
7
3

query II nosort
SELECT COUNT(score), COUNT(DISTINCT score) FROM people
----
8
7

query II nosort
SELECT SUM(DISTINCT quantity), COUNT(DISTINCT product) FROM orders
----
22
6

