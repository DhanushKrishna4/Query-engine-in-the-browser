# A NULL grouping key is a group of its own, and all NULLs land in it.
query RI rowsort
SELECT score, COUNT(*) FROM people GROUP BY score
----
7.000
1
8.250
1
8.400
1
8.800
1
9.100
1
9.500
2
9.900
1
NULL
2

query II rowsort
SELECT shipped, COUNT(*) FROM orders GROUP BY shipped
----
0
4
1
7
NULL
1

# Grouping by an expression, matched syntactically in the SELECT list.
query II rowsort
SELECT age / 10, COUNT(*) FROM people GROUP BY age / 10
----
3
3
4
4
5
2
6
1

query TI rowsort
SELECT CASE WHEN salary > 180000 THEN 'high' ELSE 'normal' END, COUNT(*) FROM people GROUP BY CASE WHEN salary > 180000 THEN 'high' ELSE 'normal' END
----
high
4
normal
6

# A grouping key can be used in a larger expression in the SELECT list.
query TI rowsort
SELECT city || '!', COUNT(*) FROM people GROUP BY city
----
Austin!
1
Cambridge!
1
Hampton!
1
London!
3
New York!
2
Palo Alto!
1
Yorktown!
1

# HAVING filters groups, after aggregation.
query TI rowsort
SELECT city, COUNT(*) FROM people GROUP BY city HAVING COUNT(*) > 1
----
London
3
New York
2

query TI rowsort
SELECT department, COUNT(*) FROM people GROUP BY department HAVING AVG(salary) > 170000
----
Engineering
4
Research
4

query TI rowsort
SELECT product, SUM(quantity) FROM orders GROUP BY product HAVING SUM(quantity) >= 4 AND product <> 'cable'
----
mouse
6

# HAVING can reference an aggregate that the SELECT list does not.
query T rowsort
SELECT city FROM people GROUP BY city HAVING MAX(age) > 50
----
Austin
Palo Alto
Yorktown

# WHERE narrows rows before grouping; HAVING narrows groups after.
query TI rowsort
SELECT city, COUNT(*) FROM people WHERE active GROUP BY city HAVING COUNT(*) > 1
----
London
3
New York
2

# Aggregates over a join.
query TI rowsort
SELECT p.name, COUNT(*) FROM people p JOIN orders o ON p.id = o.person_id GROUP BY p.name
----
Ada Lovelace
3
Alan Turing
2
Barbara Liskov
2
Frances Allen
1
Grace Hopper
1
Katherine Johnson
1
Margaret Hamilton
1
Tim Berners-Lee
1

query TR rowsort
SELECT p.city, SUM(o.unit_price * o.quantity) FROM people p JOIN orders o ON p.id = o.person_id GROUP BY p.city
----
Cambridge
39.950
Hampton
612.000
London
4472.980
New York
868.890
Yorktown
1224.000

# An outer join feeding an aggregate: the NULL-padded rows must not be counted
# by COUNT(o.order_id), though COUNT(*) still counts the row.
query TII rowsort
SELECT p.name, COUNT(*), COUNT(o.order_id) FROM people p LEFT JOIN orders o ON p.id = o.person_id GROUP BY p.name
----
Ada Lovelace
3
3
Alan Turing
2
2
Barbara Liskov
2
2
Donald Knuth
1
0
Edsger Dijkstra
1
0
Frances Allen
1
1
Grace Hopper
1
1
Katherine Johnson
1
1
Margaret Hamilton
1
1
Tim Berners-Lee
1
1

# LIMIT applies after aggregation. Which groups it keeps is only defined once
# there is an ORDER BY, so this asks for more than there are.
query TI rowsort
SELECT city, COUNT(*) FROM people GROUP BY city LIMIT 100
----
Austin
1
Cambridge
1
Hampton
1
London
3
New York
2
Palo Alto
1
Yorktown
1

# Group emission order is not something SQL defines, so it is not in the
# differential corpus -- but this engine does guarantee one: groups come out in
# the order they were first seen, because the hash table is only an index into
# an insertion-ordered vector. Without that, repeated runs of the same query
# could return different rows under a LIMIT.
onlyif qe
query TI nosort
SELECT city, COUNT(*) FROM people GROUP BY city LIMIT 3
----
London
3
New York
2
Austin
1
