14

# CROSS JOIN and its comma spelling produce the same thing.
query I nosort
SELECT COUNT(*) FROM people CROSS JOIN orders
----
120

query I nosort
SELECT COUNT(*) FROM people, orders
----
120

# A condition in WHERE across a comma join is an inner join by another name.
query TT rowsort
SELECT people.name, orders.product FROM people, orders WHERE people.id = orders.person_id
----
