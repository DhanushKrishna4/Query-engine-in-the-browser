# The same residual under a LEFT JOIN: rows failing it are still emitted padded,
# which is the difference between a join condition and a WHERE filter.
query TT rowsort
SELECT p.name, o.product FROM people p LEFT JOIN orders o ON p.id = o.person_id AND o.quantity > 1
