# Expression semantics: precedence, coercion, and every operator the
# expression grammar supports.

load people data/people.csv
load orders data/orders.csv

# Precedence: * before +, AND before OR, NOT looser than comparison.
query I nosort
SELECT 1 + 2 * 3
----
7

query I nosort
SELECT (1 + 2) * 3
----
9

query I nosort
SELECT 1 - 2 - 3
----
-4

query I rowsort
SELECT id FROM people WHERE city = 'London' OR city = 'Austin' AND age > 50
----
1
3
4
9

query I rowsort
SELECT id FROM people WHERE (city = 'London' OR city = 'Austin') AND age > 50
----
4

query I rowsort
SELECT id FROM people WHERE NOT age = 36
----
10
2
3
4
5
6
7
8
9

# Integer arithmetic, including truncation toward zero on both / and %.
query I nosort
SELECT 7 / 2
----
3

query I nosort
SELECT -7 / 2
----
-3

query I nosort
SELECT -7 % 2
----
-1

query R nosort
SELECT 7.0 / 2
----
3.500

# Mixed integer/float widens to float.
query R nosort
SELECT 1 + 2.5
----
3.500

query IR rowsort
SELECT id, salary * 1.1 FROM people WHERE id <= 3
----
1
203500.000
2
211200.000
3
195800.000

# Comparison across integer widths and against a float column.
query I rowsort
SELECT id FROM people WHERE age > 40.5
----
10
2
3
4
6
7
9

query I rowsort
SELECT id FROM people WHERE score > age
----

# String comparison is byte-wise and case-sensitive.
query T rowsort
SELECT name FROM people WHERE name < 'B'
----
Ada Lovelace
Alan Turing

query T rowsort
SELECT city FROM people WHERE city > 'New York'
----
Palo Alto
Yorktown

# Concatenation, including a number coerced to text.
query T rowsort
SELECT name || ' (' || city || ')' FROM people WHERE id <= 3
----
Ada Lovelace (London)
Alan Turing (London)
Grace Hopper (New York)

query T nosort
SELECT 'order-' || 1001
----
order-1001

# BETWEEN and NOT BETWEEN.
query I rowsort
SELECT id FROM people WHERE age BETWEEN 38 AND 45
----
2
3
5
7
8

query I rowsort
SELECT id FROM people WHERE age NOT BETWEEN 38 AND 45
----
1
10
4
6
9

query I rowsort
SELECT order_id FROM orders WHERE ordered_on BETWEEN '2024-02-01' AND '2024-04-30'
----
1003
1004
1005
1006
1007
1008

# IN and NOT IN over a literal list.
query I rowsort
SELECT id FROM people WHERE id IN (1, 3, 99)
----
1
3

query T rowsort
SELECT name FROM people WHERE department IN ('Research', 'Analytics')
----
Alan Turing
Donald Knuth
Edsger Dijkstra
Frances Allen
Katherine Johnson
Tim Berners-Lee

query T rowsort
SELECT product FROM orders WHERE product NOT IN ('cable', 'mouse', 'keyboard')
----
desk
desk
laptop
laptop
monitor
monitor

# LIKE. The generator sets PRAGMA case_sensitive_like=ON so that SQLite matches
# the standard (and this engine) rather than its own default.
query T rowsort
SELECT name FROM people WHERE name LIKE 'A%'
----
Ada Lovelace
Alan Turing

query T rowsort
SELECT name FROM people WHERE name LIKE 'a%'
----

query T rowsort
SELECT name FROM people WHERE name LIKE '%a%a%'
----
Ada Lovelace
Barbara Liskov
Margaret Hamilton

query T rowsort
SELECT name FROM people WHERE name LIKE '___a%'
----
Donald Knuth

query T rowsort
SELECT product FROM orders WHERE product NOT LIKE '%o%'
----
cable
cable
desk
desk

query T rowsort
SELECT name FROM people WHERE name LIKE '%Lee'
----
Tim Berners-Lee

# ESCAPE makes a wildcard literal.
query T nosort
SELECT 'a_b' WHERE 'a_b' LIKE 'a!_b' ESCAPE '!'
----
a_b

query T nosort
SELECT 'axb' WHERE 'axb' LIKE 'a!_b' ESCAPE '!'
----

# CASE, searched and simple.
query IT rowsort
SELECT id, CASE WHEN age < 40 THEN 'young' WHEN age < 50 THEN 'mid' ELSE 'senior' END FROM people
----
1
young
10
senior
2
mid
3
mid
4
senior
5
young
6
senior
7
mid
8
young
9
mid

query IT rowsort
SELECT id, CASE department WHEN 'Engineering' THEN 'eng' WHEN 'Research' THEN 'res' ELSE 'other' END FROM people
----
1
eng
10
other
2
eng
3
res
4
res
5
eng
6
res
7
other
8
eng
9
res

query IR rowsort
SELECT id, CASE WHEN score > 9 THEN score * 2 ELSE score END FROM people
----
1
19.000
10
8.400
2
8.250
3
NULL
4
7.000
5
19.000
6
19.800
7
8.800
8
18.200
9
NULL

# CAST.
query R rowsort
SELECT CAST(age AS FLOAT) FROM people WHERE id <= 2
----
36.000
45.000

query I nosort
SELECT CAST('42' AS BIGINT)
----
42

query I nosort
SELECT CAST(9.9 AS INT)
----
9

query I nosort
SELECT CAST(-9.9 AS INT)
----
-9

query T nosort
SELECT CAST(42 AS TEXT)
----
42

query I nosort
SELECT CAST(NULL AS INT)
----
NULL

# Comparison operators produce 1/0, matching SQLite's integer booleans.
query I nosort
SELECT 1 = 1
----
1

query I nosort
SELECT 1 <> 1
----
0

query I rowsort
SELECT id FROM people WHERE age >= 52
----
10
4
6

query I rowsort
SELECT id FROM people WHERE age <= 38
----
1
5

# ILIKE has no SQLite equivalent, so these are hand-written and marked
# engine-only; the generator leaves them alone.
onlyif qe
query T rowsort
SELECT name FROM people WHERE name ILIKE 'a%'
----
Ada Lovelace
Alan Turing

onlyif qe
query T rowsort
SELECT name FROM people WHERE name ILIKE '%LEE'
----
Tim Berners-Lee
