# No GROUP BY at all: one group over the joined rows.
query II
SELECT COUNT(*), SUM(o.quantity) FROM orders o JOIN people p ON o.person_id = p.id
----
12
32

# AVG is not decomposable and must be left alone.
query TR rowsort
SELECT p.city, AVG(o.quantity) FROM orders o JOIN people p ON o.person_id = p.id GROUP BY p.city
----
Cambridge
5.000
Hampton
1.000
London
1.833
New York
4.333
Yorktown
2.000

# Neither is COUNT(DISTINCT).
query TI rowsort
SELECT p.city, COUNT(DISTINCT o.product)
FROM orders o JOIN people p ON o.person_id = p.id GROUP BY p.city
----
Cambridge
1
Hampton
1
London
4
New York
3
Yorktown
1

