# Three tables: the partial has to survive being reordered around.
query TI rowsort
SELECT p.city, COUNT(*) FROM orders o JOIN people p ON o.person_id = p.id
JOIN people q ON q.id = p.id GROUP BY p.city
----
Cambridge
1
