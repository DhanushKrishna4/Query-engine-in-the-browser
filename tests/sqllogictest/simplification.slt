# Predicate simplification and contradiction detection.
#
# Every rewrite here must leave the answer alone, which is what makes these
# worth putting in the differential corpus rather than only in plan assertions:
# SQLite computes the same rows without any of these rules, and
# `evaluator_agreement.rs` runs each of them again with the optimizer disabled.

load people data/people.csv

# --- redundant bounds -------------------------------------------------------

query T
SELECT name FROM people WHERE age > 50 AND age > 30 ORDER BY name
----
Donald Knuth
Edsger Dijkstra
Frances Allen

query T
SELECT name FROM people WHERE age < 40 AND age <= 45 AND age < 60 ORDER BY name
----
Ada Lovelace
Barbara Liskov
Margaret Hamilton

query T
SELECT name FROM people WHERE age >= 41 AND age > 40 ORDER BY name
----
Alan Turing
Donald Knuth
Edsger Dijkstra
Frances Allen
Grace Hopper
Katherine Johnson
Tim Berners-Lee

# A bound that is *not* redundant survives on each end.
query T
SELECT name FROM people WHERE age > 38 AND age < 45 ORDER BY name
----
Alan Turing
Katherine Johnson
Margaret Hamilton

# Equality pins both ends, and a weaker bound around it says nothing.
query T
SELECT name FROM people WHERE age = 41 AND age > 30 AND age < 90 ORDER BY name
----
Alan Turing

# --- contradictions ---------------------------------------------------------

query T
SELECT name FROM people WHERE age > 50 AND age < 30
----

query T
SELECT name FROM people WHERE age = 41 AND age > 50
----

query T
SELECT name FROM people WHERE age > 40 AND age < 40
----

query T
SELECT name FROM people WHERE salary > 200000 AND salary <= 100000
----

# `>= 40 AND <= 40` is satisfiable by exactly 40 and must NOT be called a
# contradiction -- the inclusive case is the one an interval check gets wrong.
query TI
SELECT name, age FROM people WHERE age >= 41 AND age <= 41 ORDER BY name
----
Alan Turing
41

# --- NULLs ------------------------------------------------------------------
#
# `score` is NULL for two rows. A dropped conjunct must not change what happens
# to them: UNKNOWN AND UNKNOWN is UNKNOWN, and so is UNKNOWN alone.

query TR
SELECT name, score FROM people WHERE score > 9 AND score > 7 ORDER BY name
----
Ada Lovelace
9.500
Barbara Liskov
9.500
Donald Knuth
9.900
Margaret Hamilton
9.100

query I
SELECT COUNT(*) FROM people WHERE score > 9 AND score < 1
----
0

query I
SELECT COUNT(*) FROM people WHERE score IS NULL AND score > 5
----
0

# --- mixed with predicates the rule does not understand ---------------------

query T
SELECT name FROM people WHERE age > 30 AND city = 'London' AND age > 45 ORDER BY name
----
Tim Berners-Lee

query T
SELECT name FROM people WHERE age > 30 AND name LIKE 'A%' AND age > 35 ORDER BY name
----
Ada Lovelace
Alan Turing

# Different columns each keep their own interval.
query T
SELECT name FROM people WHERE age > 35 AND salary > 150000 AND age > 40 AND salary > 170000 ORDER BY name
----
Alan Turing
Grace Hopper
Tim Berners-Lee

# An OR is not a conjunction and nothing inside it is touched.
query T
SELECT name FROM people WHERE (age > 50 AND age < 30) OR city = 'London' ORDER BY name
----
Ada Lovelace
Alan Turing
Tim Berners-Lee

# --- through a join ---------------------------------------------------------

query TI
SELECT a.name, a.age FROM people a JOIN people b ON a.id = b.id
WHERE a.age > 40 AND a.age > 50 ORDER BY a.name
----
Donald Knuth
61
Edsger Dijkstra
52
Frances Allen
57

# --- outer join demoted to inner --------------------------------------------
#
# The rewrite fires only when a predicate above rejects the padding. These
# check both directions: the ones that must fire, and the ones that must not
# because the query is *asking* for the padded rows.

load orders data/orders.csv

query TT rowsort
SELECT p.name, o.product FROM people p LEFT JOIN orders o ON p.id = o.person_id
WHERE o.quantity > 1
----
Ada Lovelace
keyboard
Ada Lovelace
mouse
Alan Turing
mouse
Barbara Liskov
monitor
Frances Allen
desk
Grace Hopper
cable
Margaret Hamilton
cable

query TT rowsort
SELECT p.name, o.product FROM people p LEFT JOIN orders o ON p.id = o.person_id
WHERE o.product LIKE 'l%'
----
Ada Lovelace
laptop
Tim Berners-Lee
laptop

query TT rowsort
SELECT p.name, o.product FROM people p LEFT JOIN orders o ON p.id = o.person_id
WHERE o.quantity BETWEEN 2 AND 4
----
Ada Lovelace
keyboard
Ada Lovelace
mouse
Alan Turing
mouse
Barbara Liskov
monitor
Frances Allen
desk

# Must NOT fire: this is how an anti-join is written, and demoting the join
# would return nothing at all.
query T rowsort
SELECT p.name FROM people p LEFT JOIN orders o ON p.id = o.person_id
WHERE o.product IS NULL
----
Donald Knuth
Edsger Dijkstra

# Must NOT fire: a disjunction can be true on a padded row.
query T rowsort
SELECT p.name FROM people p LEFT JOIN orders o ON p.id = o.person_id
WHERE o.quantity > 1 OR p.age > 50
----
Ada Lovelace
Ada Lovelace
Alan Turing
Barbara Liskov
Donald Knuth
Edsger Dijkstra
Frances Allen
Grace Hopper
Margaret Hamilton

# A conjunction rejects if either half does, so this one fires.
query T rowsort
SELECT p.name FROM people p LEFT JOIN orders o ON p.id = o.person_id
WHERE p.age > 30 AND o.quantity > 2
----
Ada Lovelace
Grace Hopper
Margaret Hamilton

# A predicate only on the preserved side changes nothing about the padding.
query I
SELECT COUNT(*) FROM people p LEFT JOIN orders o ON p.id = o.person_id WHERE p.age > 45
----
4

# RIGHT joins are the mirror image.
query TT rowsort
SELECT p.name, o.product FROM orders o RIGHT JOIN people p ON p.id = o.person_id
WHERE o.quantity > 2
----
Ada Lovelace
mouse
Grace Hopper
cable
Margaret Hamilton
cable

query T rowsort
SELECT p.name FROM orders o RIGHT JOIN people p ON p.id = o.person_id
WHERE o.product IS NULL
----
Donald Knuth
Edsger Dijkstra

# A FULL join with one side rejected keeps the other side's preservation.
query I
SELECT COUNT(*) FROM people p FULL JOIN orders o ON p.id = o.person_id WHERE o.quantity > 1
----
7

query I
SELECT COUNT(*) FROM people p FULL JOIN orders o ON p.id = o.person_id
WHERE o.quantity > 1 AND p.age > 30
----
7

query I
SELECT COUNT(*) FROM people p FULL JOIN orders o ON p.id = o.person_id
WHERE o.product IS NULL OR p.name IS NULL
----
2

# --- common subexpression elimination ---------------------------------------
#
# The rewrite computes a repeated subexpression once in a projection below.
# Nothing about the answer may change, which is the only thing these check --
# the plan shape is asserted in the unit tests.

query II
SELECT (age + salary), (age + salary) * 2 FROM people ORDER BY id LIMIT 4
----
185036
370072
192045
384090
178041
356082
169052
338104

query III
SELECT (age * 2), (age * 2) + 1, (age * 2) * (age * 2) FROM people ORDER BY id LIMIT 3
----
72
73
5184
90
91
8100
82
83
6724

# Different columns, same shape: `a + b` and `b + a` are not the same key, and
# neither is `age + salary` from a different relation.
query II
SELECT (age + salary), (salary + age) FROM people ORDER BY id LIMIT 3
----
185036
185036
192045
192045
178041
178041

# A guarded division inside CASE must not be lifted out of its guard. Every row
# with age 0 would divide by zero if it were.
query II
SELECT CASE WHEN age > 0 THEN salary / age ELSE 0 END,
       CASE WHEN age > 0 THEN salary / age ELSE 1 END
FROM people ORDER BY id LIMIT 4
----
5138
5138
4266
4266
4341
4341
3250
3250

# The same shape on the right of an AND, which is also evaluated lazily.
query I
SELECT COUNT(*) FROM people
WHERE (age > 0 AND salary / age > 1000) AND (age > 0 AND salary / age > 2000)
----
10

# Repeated string expressions.
query TT
SELECT (name || '-' || city), (name || '-' || city) FROM people ORDER BY id LIMIT 3
----
Ada Lovelace-London
Ada Lovelace-London
Grace Hopper-New York
Grace Hopper-New York
Alan Turing-London
Alan Turing-London

# Repeated inside a filter as well as a projection.
query II
SELECT (age + 1), (age + 1) * 3 FROM people WHERE (age + 1) > 45 ORDER BY id
----
46
138
53
159
62
186
50
150
58
174

# NULLs through a hoisted expression.
query IR
SELECT id, (score * 2) FROM people WHERE (score * 2) IS NULL ORDER BY id
----
3
NULL
9
NULL

# --- aggregate pushdown through a join --------------------------------------
#
# Eager aggregation: a partial aggregate below the join, combined above. The
# duplicate-key cases are the ones that matter -- the whole reason this needs no
# uniqueness proof is that the aggregate above fixes up the join's duplication,
# and a dimension row that matches twice is what proves it.

query TI rowsort
SELECT p.city, COUNT(*) FROM orders o JOIN people p ON o.person_id = p.id GROUP BY p.city
----
Cambridge
1
Hampton
1
London
6
New York
3
Yorktown
1

query TI rowsort
SELECT p.city, SUM(o.quantity) FROM orders o JOIN people p ON o.person_id = p.id GROUP BY p.city
----
Cambridge
5
Hampton
1
London
11
New York
13
Yorktown
2

query TII rowsort
SELECT p.department, MIN(o.quantity), MAX(o.quantity)
FROM orders o JOIN people p ON o.person_id = p.id GROUP BY p.department
----
Analytics
1
2
Engineering
1
10
Research
1
2

query TIII rowsort
SELECT p.city, COUNT(*), SUM(o.quantity), MAX(o.unit_price)
FROM orders o JOIN people p ON o.person_id = p.id GROUP BY p.city
----
Cambridge
1
5
7
Hampton
1
1
612
London
6
11
1899
New York
3
13
349
Yorktown
1
2
612

