# Projection, filtering and name resolution.
#
# Expected results are generated by SQLite: python3 tools/gen_expected.py --write

load people data/people.csv
load orders data/orders.csv

query IT rowsort
SELECT id, name FROM people WHERE age > 40
----
10
Frances Allen
2
Grace Hopper
3
Alan Turing
4
Edsger Dijkstra
6
Donald Knuth
7
Katherine Johnson
9
Tim Berners-Lee

query T rowsort
SELECT name FROM people WHERE city = 'London'
----
Ada Lovelace
Alan Turing
Tim Berners-Lee

query TI rowsort
SELECT name, salary FROM people WHERE department = 'Research' AND age < 50
----
Alan Turing
178000
Tim Berners-Lee
188000

# Every column, in schema order.
query ITITTIRTI rowsort
SELECT * FROM people WHERE id <= 2
----
1
Ada Lovelace
36
London
Engineering
185000
9.500
2001-05-01
1
2
Grace Hopper
45
New York
Engineering
192000
8.250
1999-11-30
1

# An alias replaces the table name as a qualifier.
query IT rowsort
SELECT p.id, p.name FROM people p WHERE p.city = 'New York'
----
2
Grace Hopper
5
Barbara Liskov

# Unquoted identifiers are case-insensitive.
query T rowsort
SELECT NAME FROM PEOPLE WHERE Id = 4
----
Edsger Dijkstra

query TR rowsort
SELECT product, unit_price FROM orders WHERE quantity >= 4
----
cable
7.990
cable
7.990
mouse
24.250

query IT rowsort
SELECT order_id, ordered_on FROM orders WHERE ordered_on >= '2024-05-01'
----
1009
2024-05-08
1010
2024-05-30
1011
2024-06-14
1012
2024-07-03

# Boolean columns compare as integers on the SQLite side; the harness renders
# this engine's BOOLEAN as 1/0 to match.
query II rowsort
SELECT order_id, shipped FROM orders WHERE shipped
----
1001
1
1002
1
1004
1
1005
1
1007
1
1009
1
1011
1

query I rowsort
SELECT order_id FROM orders WHERE NOT shipped
----
1003
1006
1010
1012
