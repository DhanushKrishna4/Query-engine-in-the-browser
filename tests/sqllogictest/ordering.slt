Alan Turing
41
Katherine Johnson
44
Grace Hopper
45
Tim Berners-Lee
49
Edsger Dijkstra
52
Frances Allen
57
Donald Knuth
61

query TI nosort
SELECT name, age FROM people ORDER BY age LIMIT 0
----

# Ordering after a filter and after a join.
query TI nosort
SELECT name, age FROM people WHERE city = 'London' ORDER BY age DESC
----
