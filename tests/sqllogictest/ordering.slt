New York
2
Austin
1
Cambridge
1
Hampton
1
Palo Alto
1
Yorktown
1

query TR nosort
SELECT department, AVG(salary) FROM people GROUP BY department ORDER BY 2
----
Analytics
146500.000
Research
172500.000
Engineering
188500.000

# DISTINCT.
query T rowsort
SELECT DISTINCT city FROM people
----
Austin
Cambridge
Hampton
London
New York
Palo Alto
Yorktown

query T nosort
SELECT DISTINCT city FROM people ORDER BY city
----
Austin
Cambridge
Hampton
London
New York
Palo Alto
Yorktown

query TT rowsort
SELECT DISTINCT city, department FROM people
----
Austin
Research
Cambridge
Engineering
Hampton
Analytics
London
Engineering
London
Research
New York
Engineering
Palo Alto
Research
Yorktown
Analytics

# NULLs are equal to each other for DISTINCT, so they collapse to one row.
query R rowsort
SELECT DISTINCT score FROM people
----
7.000
8.250
8.400
8.800
9.100
9.500
9.900
NULL

query I nosort
SELECT COUNT(*) FROM (SELECT DISTINCT city FROM people) AS x
----
7

query T nosort
SELECT DISTINCT city FROM people ORDER BY city LIMIT 2
----
Austin
Cambridge

# DISTINCT over an expression.
query I rowsort
SELECT DISTINCT age / 10 FROM people
----
3
4
5
6

query T rowsort
SELECT DISTINCT shipped FROM orders
----
0
1
NULL
