# ORDER BY with LIMIT, which is what the top-N heap is for.
query TI nosort
SELECT name, age FROM people ORDER BY age LIMIT 3
----
Ada Lovelace
36
Barbara Liskov
38
Margaret Hamilton
39

query TI nosort
SELECT name, age FROM people ORDER BY age DESC LIMIT 3
----
Donald Knuth
61
Frances Allen
57
Edsger Dijkstra
52

query TI nosort
SELECT name, age FROM people ORDER BY age LIMIT 3 OFFSET 4
----
Katherine Johnson
44
Grace Hopper
45
Tim Berners-Lee
49

# A limit larger than the input, and a limit of zero.
query TI nosort
SELECT name, age FROM people ORDER BY age LIMIT 100
----
