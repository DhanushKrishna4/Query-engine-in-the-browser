# Sorting by something that is not selected: the key becomes a hidden column
# and is trimmed off again.
query T nosort
SELECT name FROM people ORDER BY salary DESC
----
Barbara Liskov
Grace Hopper
Tim Berners-Lee
Ada Lovelace
Alan Turing
Margaret Hamilton
Edsger Dijkstra
Donald Knuth
Frances Allen
Katherine Johnson

