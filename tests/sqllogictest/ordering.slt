# Ordering an aggregate by one of its outputs.
query TI nosort
SELECT city, COUNT(*) AS n FROM people GROUP BY city ORDER BY n DESC, city
----
London
3
New York
2
Austin
1
Cambridge
1
Hampton
1
Palo Alto
1
Yorktown
1

query TI nosort
SELECT city, COUNT(*) FROM people GROUP BY city ORDER BY COUNT(*) DESC, city
