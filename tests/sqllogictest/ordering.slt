Margaret Hamilton
Alan Turing
Ada Lovelace
Tim Berners-Lee
Grace Hopper
Barbara Liskov

# NULL placement. `score` has two NULLs; the default is NULLs first ascending
# and last descending, which is what SQLite does.
query TR nosort
SELECT name, score FROM people ORDER BY score, name
