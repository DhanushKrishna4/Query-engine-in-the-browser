# ORDER BY, DISTINCT, and how they interact with LIMIT.
#
# These use nosort: the order *is* the answer. Keys are chosen to be unique or
# fully tie-broken, since neither engine promises a stable sort.

load people data/people.csv
load orders data/orders.csv

query TI nosort
SELECT name, age FROM people ORDER BY age
----
Ada Lovelace
36
Barbara Liskov
38
Margaret Hamilton
39
Alan Turing
41
Katherine Johnson
44
Grace Hopper
45
Tim Berners-Lee
49
Edsger Dijkstra
52
Frances Allen
57
Donald Knuth
61

query TI nosort
SELECT name, age FROM people ORDER BY age DESC
----
Donald Knuth
61
Frances Allen
57
Edsger Dijkstra
52
Tim Berners-Lee
49
Grace Hopper
45
Katherine Johnson
44
Alan Turing
41
Margaret Hamilton
39
Barbara Liskov
38
Ada Lovelace
36

