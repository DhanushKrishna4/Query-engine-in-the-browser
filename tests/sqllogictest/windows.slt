# --- several windows in one query ------------------------------------------
#
# Each window sorts, so with more than one the output order is whichever sorted
# last -- undefined by SQL and different between the two engines. These say
# explicitly what order they want.

query TIII nosort
SELECT name, ROW_NUMBER() OVER (ORDER BY age), ROW_NUMBER() OVER (ORDER BY salary), age FROM people ORDER BY name
