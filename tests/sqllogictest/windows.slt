# RANK leaves gaps after a tie, DENSE_RANK does not. `score` has two rows at
# 9.5 and two NULLs, which is exactly the interesting case.
query TRII nosort
SELECT name, score, RANK() OVER (ORDER BY score), DENSE_RANK() OVER (ORDER BY score) FROM people
