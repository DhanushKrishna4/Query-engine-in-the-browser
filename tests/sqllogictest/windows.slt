# Window functions.
#
# A window function does not promise to preserve input order, and both engines
# emit rows in the window's own sorted order -- so these use nosort where the
# ordering is determined by the window, and an explicit ORDER BY where it is
# not.

load people data/people.csv
load orders data/orders.csv

# --- ranking ---------------------------------------------------------------

query TI nosort
SELECT name, ROW_NUMBER() OVER (ORDER BY age) FROM people
----
